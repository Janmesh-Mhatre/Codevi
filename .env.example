# Copy this file to .env.local and adjust as needed. Neither file is
# committed (see .gitignore) — .env.example just documents what's
# available. Code Visualizer runs fully offline, so there are no API
# keys or endpoints to configure here, only local dev/runtime knobs.

# Minimum level written to the console by src/utils/logger.ts.
# One of: debug | info | warn | error. Defaults to "debug".
VITE_LOG_LEVEL=debug

# Only used when developing for a physical mobile device via
# `npm run tauri android dev` / `ios dev` — leave unset for normal
# desktop development. Read directly by vite.config.ts.
# TAURI_DEV_HOST=
